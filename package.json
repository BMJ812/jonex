{
  "name": "jonex-platform",
  "version": "0.1.5",
  "private": true,
  "description": "JØNEX is a local-first operations platform for developers and homelab operators.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @jonex/shell run dev",
    "tauri:dev": "npm --workspace @jonex/shell run tauri:dev",
    "build": "npm run version:check && npm run build:frontend && npm run build:rust",
    "build:frontend": "npm --workspace @jonex/shell run build",
    "build:rust": "cargo build --workspace --locked",
    "build:desktop": "npm --workspace @jonex/shell run tauri:build",
    "lint": "npm --workspace @jonex/shell run lint",
    "test": "npm --workspace @jonex/shell run test",
    "test:rust": "cargo test --workspace --locked",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "check": "npm run version:check && npm run lint && npm run test && npm run format:check && npm run clippy && npm run test:rust"
  },
  "engines": {
    "node": ">=22"
  }
}
